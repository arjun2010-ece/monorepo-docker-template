# .dockerignore filters what `docker build` sends to the daemon.

# Dependencies — installed INSIDE the image, never copied from the host.
node_modules

# Build artifacts — rebuilt inside the image.
dist
build
*.tsbuildinfo

# Secrets — `COPY . .` would bake these into a layer permanently.
.env
.env.*
*.pem
*.key

# Version control, CI, editor and OS noise.
.git
.gitignore
.github
.vscode
.idea
.DS_Store
*.log

# Docker files themselves.
Dockerfile*
docker-compose*.yml
.dockerignore

# Docs and tests not needed inside the image.
README.md
Dockerfile-usage.md
coverage
**/*.spec.ts
**/*.test.ts
