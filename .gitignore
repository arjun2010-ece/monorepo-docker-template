# --- Dependencies (installed inside Docker images / locally via npm install) ---
node_modules/

# --- Build outputs (recreated by `next build` / `nest build`) ---
.next/
out/
dist/
build/
*.tsbuildinfo

# --- Environment & secrets: NEVER commit these ---
# Runtime config belongs in the orchestrator / secret manager, not in git.
.env
.env.local
.env.*.local
.env.*
!.env.example

# --- Logs ---
*.log
npm-debug.log*
yarn-error.log*

# --- Test coverage ---
coverage/

# --- OS / editor noise ---
.DS_Store
Thumbs.db
.idea/
.vscode/

# --- Docker local artifacts (images are built from source, not committed) ---
docker-compose.override.yml
