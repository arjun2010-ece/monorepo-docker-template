{
  "name": "jobboard",
  "version": "1.0.0",
  "private": true,
  "description": "Job-board app: Next.js frontend + NestJS API in an npm workspaces monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @jobboard/web",
    "dev:api": "npm run start:dev --workspace @jobboard/api",
    "build:web": "npm run build --workspace @jobboard/web",
    "build:api": "npm run build --workspace @jobboard/api"
  },
  "engines": {
    "node": ">=22"
  }
}
